{
  "name": "portafolio",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node tools/check-links.mjs",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path config/prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path config/prettierignore",
    "check:html": "html-validate --config config/htmlvalidate.json \"dist/**/*.html\" ops/maintenance.html",
    "lighthouse": "pnpm dlx @lhci/cli@0.16.1 autorun --config=config/lighthouserc.json",
    "check:guard": "node tools/guard.mjs",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "prepare": "lefthook install",
    "check:commits": "node tools/commit-msg.mjs --range origin/main..HEAD"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "1.65.0",
    "html-validate": "11.21.1",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
