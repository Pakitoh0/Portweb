---
// Barra superior estilo waybar: workspaces = secciones
const workspaces = [
  { n: 1, id: 'inicio', label: 'inicio' },
  { n: 2, id: 'sobre-mi', label: 'sobre-mí' },
  { n: 3, id: 'proyectos', label: 'proyectos' },
  { n: 4, id: 'herramientas', label: 'herramientas' },
  { n: 5, id: 'contacto', label: 'contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-2">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-2 rounded-xl border border-overlay bg-surface/90 px-3 py-1.5 text-xs backdrop-blur">
    <ul class="flex gap-1 overflow-x-auto">
      {workspaces.map((w) => (
        <li>
          <a
            href={`#${w.id}`}
            data-ws={w.id}
            class="ws block rounded-md px-2 py-0.5 text-subtle transition hover:bg-overlay hover:text-text"
          >
            <span class="ws-n text-mauve">{w.n}</span>
            <span class="hidden sm:inline">:{w.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="flex shrink-0 items-center gap-3 text-subtle">
      <span class="hidden md:inline">
        <span class="text-green">●</span> online
      </span>
      <span id="clock" class="text-blue">
        --:--
      </span>
    </div>
  </nav>
</header>

<script>
  const clock = document.getElementById('clock');
  const tick = () => {
    if (clock)
      clock.textContent = new Date().toLocaleTimeString('es-ES', {
        hour: '2-digit',
        minute: '2-digit',
      });
  };
  tick();
  setInterval(tick, 10_000);

  // Marca el workspace activo según la sección visible
  const links = document.querySelectorAll<HTMLAnchorElement>('.ws');
  const sections = [...document.querySelectorAll<HTMLElement>('section[id]')];
  const setActive = (id: string) =>
    links.forEach((l) => {
      if (l.dataset.ws === id) l.setAttribute('aria-current', 'location');
      else l.removeAttribute('aria-current');
    });
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((s) => io.observe(s));
  // La última sección no llega a la franja central: al tocar fondo, se activa ella
  const atBottom = () => {
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
      const last = sections.at(-1);
      if (last) setActive(last.id);
    }
  };
  window.addEventListener('scroll', atBottom, { passive: true });
  atBottom();
</script>
