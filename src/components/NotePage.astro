---
// Una nota técnica, como un fichero Markdown abierto en una ventana
import { render } from 'astro:content';
import Window from './Window.astro';
import Prompt from './Prompt.astro';
import { noteDate, type Note } from '../lib/notes';
import { ui, notesPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  note: Note;
}
const { lang, note } = Astro.props;
const t = ui[lang];
const { Content } = await render(note);
const dir = lang === 'es' ? 'notas' : 'notes';
---

<article class="space-y-3">
  <a href={notesPath(lang)} class="inline-block text-sm text-subtle hover:text-text">
    {t.backToNotes}
  </a>
  <Window title={`${dir}/${note.slug}.md`} bodyClass="sm:p-8">
    <Prompt cmd={`cat ${note.slug}.md`} typing />
    <p class="text-xs">
      <span class="text-amber">● {noteDate(note.data.date, lang)}</span>
      {note.data.draft && <span class="text-red"> · [{t.draft}]</span>}
    </p>
    <h1 class="mt-2 text-3xl font-bold text-text sm:text-4xl">{note.data.title}</h1>
    <p class="mt-3 max-w-3xl text-mauve">{note.data.summary}</p>
    <ul class="mt-4 flex flex-wrap gap-2 text-xs">
      {note.data.tags.map((tag) => (
        <li class="rounded bg-overlay px-2 py-0.5 text-text">{tag}</li>
      ))}
    </ul>
    <div class="note mt-8 max-w-3xl">
      <Content />
    </div>
  </Window>
</article>
