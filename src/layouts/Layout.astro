---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import Bar from '../components/Bar.astro';
import Terminal from '../components/Terminal.astro';
import { profile } from '../data/profile';
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Ruta equivalente en el otro idioma, relativa a la base (p. ej. "/en/") */
  alternate: string;
  title?: string;
  description?: string;
}
const { lang, alternate, title, description = profile.bio[lang] } = Astro.props;
const t = ui[lang];
const pageTitle = title ?? `${profile.name} · ${t.portfolio}`;

// URLs absolutas para canonical, hreflang y Open Graph
const site = Astro.site!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, site).href;
const alternateUrl = new URL(`${base}${alternate}`, site).href;
const esUrl = lang === 'es' ? canonical : alternateUrl;
const enUrl = lang === 'en' ? canonical : alternateUrl;
const ogImage = new URL(`${base}/og.png`, site).href;

// Datos estructurados (schema.org Person)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.handle,
  jobTitle: profile.role[lang],
  description: profile.bio[lang],
  url: new URL(`${base}/`, site).href,
  image: ogImage,
  address: { '@type': 'PostalAddress', addressLocality: 'Málaga', addressCountry: 'ES' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: profile.university },
  sameAs: [profile.links.github],
  knowsAbout: [
    'Software Engineering',
    'QA Automation',
    'Linux',
    'CI/CD',
    'AI-assisted development',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#11111b" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${profile.name} · ${t.portfolio}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Aplica el tema guardado antes de pintar, para que no parpadee -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('portweb-theme');
        if (saved && saved !== 'mocha') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body class="min-h-screen font-mono text-text antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-14 focus:z-[60] focus:rounded-md focus:bg-mauve focus:px-3 focus:py-1 focus:text-base"
    >
      {t.skipToContent}
    </a>
    <Bar lang={lang} alternateHref={`${base}${alternate}`} />
    <main id="contenido" class="mx-auto max-w-6xl px-4 pb-16 pt-20">
      <slot />
    </main>
    <Terminal lang={lang} />
  </body>
</html>
