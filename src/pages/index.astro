---
import Layout from '../layouts/Layout.astro';
import Window from '../components/Window.astro';
import Prompt from '../components/Prompt.astro';
import Fastfetch from '../components/Fastfetch.astro';
import { profile, projects } from '../data/profile';
const kindColor: Record<string, string> = { uni: 'text-amber', dev: 'text-blue' };
---
<Layout>
  <!-- 1: inicio — disposición tiling: ventana grande + dos apiladas -->
  <section id="inicio" class="grid min-h-[85vh] scroll-mt-20 items-center gap-3 md:grid-cols-3 md:grid-rows-2">
    <Window title="hola" class="md:col-span-2 md:row-span-2">
      <Prompt cmd="whoami" />
      <h1 class="text-4xl font-bold text-text sm:text-6xl">{profile.name}</h1>
      <p class="mt-3 text-lg text-mauve">{profile.role}</p>
      <p class="mt-6 max-w-xl text-subtle">{profile.bio}</p>
      <p class="mt-8 cursor"><span class="text-green">❯</span> </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#proyectos" class="rounded-md bg-green px-4 py-2 font-bold text-base hover:opacity-90">ver proyectos</a>
        <a href="#contacto" class="rounded-md border border-overlay px-4 py-2 hover:border-mauve">contactar</a>
      </div>
    </Window>
    <Window title="fetch">
      <pre class="text-xs leading-5"><span class="text-blue">{profile.handle}</span>@<span class="text-mauve">arch</span>
-----------------
<span class="text-green">os</span>     Arch Linux (Omarchy)
<span class="text-green">wm</span>     Hyprland
<span class="text-green">shell</span>  zsh
<span class="text-green">uni</span>    {profile.university}
<span class="text-green">loc</span>    {profile.location}</pre>
    </Window>
    <Window title="estado">
      <ul class="space-y-1 text-xs">
        <li><span class="text-green">[ok]</span> aprendiendo arquitectura RISC-V</li>
        <li><span class="text-green">[ok]</span> afinando mi setup de Hyprland</li>
        <li><span class="text-amber">[..]</span> construyendo este portafolio</li>
      </ul>
    </Window>
  </section>

  <!-- 2: sobre mí -->
  <section id="sobre-mi" class="scroll-mt-20 pt-16">
    <Window title="sobre-mi.md">
      <Prompt cmd="cat sobre-mi.md" />
      <div class="space-y-3 text-subtle">
        <p><span class="text-mauve"># </span><span class="text-text">Sobre mí</span></p>
        <p>Estudio en <span class="text-text">{profile.university}</span> y vivo entre dos mundos: el de la uni, donde diseño procesadores y programo en ensamblador, y el de mi terminal, donde construyo herramientas y personalizo Linux hasta el último píxel.</p>
        <p>Me interesa entender cómo funciona todo por dentro y convertirlo en algo útil.</p>
      </div>
    </Window>
  </section>

  <!-- 3: proyectos -->
  <section id="proyectos" class="scroll-mt-20 pt-16">
    <h2 class="mb-4 text-sm text-subtle"><span class="text-green">❯</span> <span class="text-blue">ls ~/proyectos</span></h2>
    <div class="grid gap-3 sm:grid-cols-2">
      {projects.map((p) => (
        <a href={p.url} class="block transition hover:-translate-y-0.5">
          <Window title={p.name} class="h-full">
            <p class={`mb-2 text-xs ${kindColor[p.kind]}`}>[{p.kind}]</p>
            <p class="text-subtle">{p.desc}</p>
            <ul class="mt-4 flex flex-wrap gap-2 text-xs">
              {p.tags.map((t) => <li class="rounded bg-overlay px-2 py-0.5 text-text">{t}</li>)}
            </ul>
          </Window>
        </a>
      ))}
    </div>
  </section>

  <!-- 4: herramientas (fastfetch) -->
  <section id="herramientas" class="scroll-mt-20 pt-16">
    <Window title="fastfetch">
      <Prompt cmd="fastfetch" />
      <Fastfetch />
    </Window>
  </section>

  <!-- 5: contacto -->
  <section id="contacto" class="scroll-mt-20 pt-16">
    <Window title="contacto">
      <Prompt cmd="./contactar.sh" />
      <p class="mb-4 text-subtle">¿Hablamos? Estoy abierto a prácticas, proyectos y charlas sobre Linux o hardware.</p>
      <ul class="space-y-2">
        <li><span class="text-green">github</span>   → <a class="text-blue underline-offset-4 hover:underline" href={profile.links.github}>{profile.links.github.replace('https://', '')}</a></li>
        <li><span class="text-green">linkedin</span> → <a class="text-blue underline-offset-4 hover:underline" href={profile.links.linkedin}>{profile.links.linkedin.replace('https://www.', '')}</a></li>
        <li><span class="text-green">email</span>    → <a class="text-blue underline-offset-4 hover:underline" href={`mailto:${profile.links.email}`}>{profile.links.email}</a></li>
      </ul>
    </Window>
    <p class="mt-8 text-center text-xs text-subtle">hecho con Astro + Tailwind · <span class="text-mauve">{new Date().getFullYear()}</span></p>
  </section>
</Layout>
