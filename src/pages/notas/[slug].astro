---
import Layout from '../../layouts/Layout.astro';
import NotePage from '../../components/NotePage.astro';
import { getNotes } from '../../lib/notes';

export async function getStaticPaths() {
  return (await getNotes('es')).map((note) => ({ params: { slug: note.slug }, props: { note } }));
}
const { note } = Astro.props;
---

<Layout
  lang="es"
  title={`${note.data.title} · Francisco`}
  description={note.data.summary}
  alternate={`/en/notes/${note.slug}/`}
  noindex={note.data.draft}
>
  <NotePage lang="es" note={note} />
</Layout>
