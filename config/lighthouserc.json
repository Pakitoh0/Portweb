{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 4500 --bind 127.0.0.1 --directory .lighthouseci/site",
      "startServerReadyPattern": "Serving HTTP",
      "url": ["http://127.0.0.1:4500/Portweb/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
